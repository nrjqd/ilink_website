APP_ENV=development
APP_NAME=I-Link API
API_V1_PREFIX=/api/v1

# Use psycopg 3 explicitly for local PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ilink
# Production providers may provide postgresql://... URLs, including sslmode query
# parameters. The application normalizes those to postgresql+psycopg://...
# automatically, so do not edit production secrets just to add the driver.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local SQLite fallback, only uncomment when PostgreSQL is unavailable:
# DATABASE_URL=sqlite:///./ilink_dev.db

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://127.0.0.1:5178
TRUSTED_HOSTS=localhost,127.0.0.1
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
